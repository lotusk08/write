{
  "name": "write",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "description": "A writing app built on text-editor-vue: drafts, collapsible sections, Markdown/DOCX export, and one-click publishing to the blog. Deploys to Cloudflare Workers.",
  "author": "Steve Hoang (https://stevehoang.com)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "watch": "node scripts/watch.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@erag/text-editor-vue": "^1.3.0",
    "@jsquash/webp": "^1.5.0",
    "chart.js": "^4.6.1",
    "docx": "^9.15.3",
    "lib0": "^0.2.119",
    "markdown-it": "^15.0.3",
    "markdown-it-deflist": "^4.0.0",
    "mediabunny": "^1.65.2",
    "pele": "1.13.0",
    "vue": "^3.5.45",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "patch-package": "^8.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
