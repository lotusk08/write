{
  "name": "write",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A writing app built on text-editor-vue: drafts, collapsible sections, Markdown/DOCX export, and one-click publishing to the blog. Deploys to Cloudflare Workers.",
  "author": "Steve Hoang (https://stevehoang.com)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@erag/text-editor-vue": "^1.3.0",
    "chart.js": "^4.6.1",
    "docx": "^9.14.0",
    "lib0": "^0.2.119",
    "mermaid": "^12.2.0",
    "vue": "^3.5.44",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "patch-package": "^8.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
