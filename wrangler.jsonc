{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "write",
  // Static files, nothing else: the app publishes to GitHub from the browser,
  // so this deployment has no code of its own and no secrets to hold.
  // `npm run deploy` uploads dist as a Pages project; the custom domain
  // (write.stevehoang.com, which the blog's edit button links to) is attached
  // to that project in the Cloudflare dashboard.
  "pages_build_output_dir": "dist"
}
