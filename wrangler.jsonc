{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "write",
  "compatibility_date": "2026-06-01",
  // Static files, nothing else: the app publishes to GitHub from the browser,
  // so this deployment has no code of its own and no secrets to hold. With no
  // `main`, `wrangler deploy` uploads `dist` and Cloudflare serves it — the
  // Worker is the asset server and runs no script.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // The blog's *Edit this post* button links here, so this name has to keep
  // answering. It is attached to this Worker, not to a Pages project: deploying
  // anywhere else leaves the old app sitting on the domain.
  "routes": [{ "pattern": "write.stevehoang.com", "custom_domain": true }]
}
