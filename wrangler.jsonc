{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "write",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [{ "name": "SHARE", "class_name": "ShareRoom" }]
  },
  "migrations": [{ "tag": "share-rooms", "new_sqlite_classes": ["ShareRoom"] }],
  "unsafe": {
    "bindings": [
      {
        "name": "SHARE_RATE",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 6, "period": 60 }
      }
    ]
  },
  "routes": [{ "pattern": "write.stevehoang.com", "custom_domain": true }],
  "vars": {
    "BLOG_REPO": "lotusk08/stevehoang.com",
    "BLOG_BRANCH": "blog",
    "SITE_URL": "https://stevehoang.com",
    "POSTS_DIR": "_posts",
    "DRAFTS_DIR": "_drafts",
    "IMAGES_DIR": "assets/img/post"
  }
}
